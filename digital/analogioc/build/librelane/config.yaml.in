# LibreLane (Classic flow) config for the digital top @MODULE_NAME@.
#
# Template: .flows/digital/build/librelane/config.yaml.in. `make AddDigitalModule`
# writes config.yaml from it. Edit config.yaml, except the generated block at the
# bottom: analog macros are declared once in ../macros.toml and `make config`
# rewrites that block (MACROS, PDN hookup, halos, don't-touch analog nets).
# Paths are relative to this file (`dir::`).
# Reference: https://librelane.readthedocs.io/en/latest/reference/configuration.html
meta:
  version: 2
  flow: Classic

DESIGN_NAME: "@MODULE_NAME@"
VERILOG_FILES: ["@VERILOG_FILES@"]

CLOCK_PORT: clk
CLOCK_PERIOD: 20 # ns

# Floorplan. For a TinyTapeout tile use the tile's DIE_AREA and pin template:
#   FP_DEF_TEMPLATE: dir::../../../../.flows/def/digital/tt_block_1x2_pg.def
# (the top then needs the tt_um_* port list).
FP_SIZING: absolute
DIE_AREA: [0, 0, 200, 200]
PL_TARGET_DENSITY_PCT: 50

# Power. The digital domain is VPWR/VGND. Only the pins a macro lists under `pg` in
# macros.toml join it (PDN_MACRO_CONNECTIONS). Analog supplies (vdd_ota, vdd_cmp,
# vdd_pkt, vdd, vss ...) are never listed, so they stay off VPWR/VGND. The std-cell
# global connections match only the SCL pin names (VPWR/VGND/VPB/VNB): do not give
# an analog supply pin one of those names.
VDD_NETS: [VPWR]
GND_NETS: [VGND]
# met5 straps have to cross each macro's met4 VPWR/VGND pins to connect to them.
PDN_VPITCH: 40
PDN_HPITCH: 40

RT_MAX_LAYER: met4

# >>> generated by build/macros.py from build/macros.toml, do not edit by hand
# <<< end generated
