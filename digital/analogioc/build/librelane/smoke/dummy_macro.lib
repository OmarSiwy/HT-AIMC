/* Hand-written Liberty for the smoke test's dummy analog macro. Numbers are
 * placeholders; the real one comes from the gap-2 .lib generator. The analog pin
 * `ana` has direction and capacitance only, no timing arcs. */
library (dummy_macro) {
  delay_model : table_lookup ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  current_unit : "1mA" ;
  capacitive_load_unit (1, pf) ;
  pulling_resistance_unit : "1kohm" ;
  leakage_power_unit : "1nW" ;
  input_threshold_pct_rise : 50 ;
  input_threshold_pct_fall : 50 ;
  output_threshold_pct_rise : 50 ;
  output_threshold_pct_fall : 50 ;
  slew_lower_threshold_pct_rise : 20 ;
  slew_upper_threshold_pct_rise : 80 ;
  slew_lower_threshold_pct_fall : 20 ;
  slew_upper_threshold_pct_fall : 80 ;
  nom_process : 1.0 ;
  nom_temperature : 25.0 ;
  nom_voltage : 1.8 ;
  operating_conditions (tt_025C_1v80) {
    process : 1.0 ;
    temperature : 25.0 ;
    voltage : 1.8 ;
  }
  default_operating_conditions : tt_025C_1v80 ;
  default_max_transition : 1.5 ;

  cell (dummy_macro) {
    area : 4800 ;
    dont_touch : true ;
    dont_use : true ;
    interface_timing : true ;
    pin (en) { direction : input ; capacitance : 0.005 ; }
    pin (c0) { direction : input ; capacitance : 0.005 ; }
    pin (c1) { direction : input ; capacitance : 0.005 ; }
    pin (c2) { direction : input ; capacitance : 0.005 ; }
    pin (c3) { direction : input ; capacitance : 0.005 ; }
    pin (ana) { direction : inout ; capacitance : 0.1 ; }
    pin (done) {
      direction : output ;
      max_capacitance : 0.2 ;
      timing () {
        related_pin : "en" ;
        timing_sense : positive_unate ;
        cell_rise (scalar) { values ("2.0") ; }
        cell_fall (scalar) { values ("2.0") ; }
        rise_transition (scalar) { values ("0.3") ; }
        fall_transition (scalar) { values ("0.3") ; }
      }
    }
  }
}
