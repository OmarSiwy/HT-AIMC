# yosys synthesis: near-tile digital rail -> sky130_fd_sc_hd
# run from scripts/digital/: yosys -l build/synth.log synth.ys
read_verilog src/nibble_combine.v
read_verilog src/slice_combine.v
read_verilog src/bacc_accum.v
read_verilog src/abft_check.v
read_verilog src/requant.v
read_verilog src/sar_ctrl.v
read_verilog src/event_ctrl.v
read_verilog src/sign_exit.v
read_verilog src/tile_fsm.v
read_verilog src/rail_top.v

synth -top rail_top

dfflibmap -liberty /home/omare/.ciel/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty /home/omare/.ciel/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
opt_clean

# per-module + total cell counts / area
stat -liberty /home/omare/.ciel/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

write_verilog -noattr build/rail_top_syn.v
