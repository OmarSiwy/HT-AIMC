// B3 one differential column pair, both slices: bottom-plate charge share, significance accumulation
// and the 1:16 slice merge (ARCH_CHOSEN B3, N2 charge rail, N4 merge). Event model on the rows'
// top-plate contributions q (imc_xp, one per row, which carry the real rail voltages), so the drive's
// finite settling and code-dependent droop arrive from imc_rowdrv / imc_ref.
//
//   phi_rst falling  top plates released: contributions recorded, kT/C reset noise on each top plate
//   phi_sh  falling  the slot: V_top = sum_r (q_r(now) - q_r(reset)) + reset noise, shared onto
//                    C_acc = r_acc C_slice (r_acc 1/3 ml2, 1 bitserial), incompletely
//                    (1 - exp(-t_share / tau_col)), plus kT/(C_slice + C_acc)
//   phi_mrg  falling MSB and LSB accumulators merged with rho (LSB slice weighs 1/16), kT/C of the
//                    merge node; outp/outn hold the merged side voltages; the accumulators reset
//                    (ping-pong banks: the next pass starts while the SAR converts this one)
// The q inputs are probed only inside the events: probing them continuously makes ESPice's event
// timestep control collapse to 0.1 fs whenever a crosspoint input moves (found in tb_cosim).
// q[4r + slice*2 + side]: slice 0 MSB, 1 LSB; side 0 drives outp, side 1 outn.
// Defaults: C_slice from 7 x 1 fF / 15 x 0.25 fF units per row (P); tau_col 39.2 ps (M-fit, N2_r2);
// ratio sigmas 0.1 % (P); e_sw 67.6 fJ per column-pass = 17.3 pJ / 256 (P, column switches).
`include "disciplines.vams"
`include "constants.vams"
module imc_col(q, phi_rst, phi_sh, phi_mrg, outp, outn, emon);
    parameter integer ROWS = 8 from [1:14];  // 4 ROWS + 6 pins <= 64 unknowns per ESPice device
    parameter integer mode = 0 from [0:1];
    parameter integer noise = 1 from [0:1];
    parameter integer merge_on_top = 0 from [0:1];
    parameter integer seed = 1;
    parameter real cu_msb = 1.0e-15;
    parameter real cu_lsb = 0.25e-15;
    parameter real c_par  = 0.0;
    parameter real sig_racc   = 1e-3;
    parameter real sig_merge  = 1e-3;
    parameter real tau_col = 39.2e-12 from (0:inf);
    parameter real temp_k  = 300;
    parameter real vth     = 0.35;
    parameter real e_sw    = 67.6e-15;
    input [0:ROWS*4-1] q; input phi_rst, phi_sh, phi_mrg;
    output outp, outn, emon;
    electrical [0:ROWS*4-1] q; electrical phi_rst, phi_sh, phi_mrg;
    electrical outp, outn, emon;

    real qv[0:63], q0[0:63];
    real vacc[0:3];          // [slice*2 + side], slice 0 = MSB, 1 = LSB
    real nrst[0:3];
    real racc[0:3], rho[0:1];
    real vm[0:1];
    real c_msb, c_lsb, r_acc, rho0, kt, t_sh0, settle, cs, ca, vtop, a, cm, etot;
    integer j, sd, sl, sd_seed;
    genvar g;
    analog begin
        @(initial_step) begin
            sd_seed = seed;
            c_msb = ROWS * 7 * cu_msb + c_par;
            c_lsb = ROWS * 15 * cu_lsb + c_par;
            r_acc = (mode == 0) ? 1.0 / 3 : 1.0;
            rho0  = (1.0 / 16) * (cu_msb / c_msb) / (cu_lsb / c_lsb);
            kt    = `P_K * temp_k;
            for (j = 0; j < 4; j = j + 1) begin
                racc[j] = r_acc * (1 + $rdist_normal(sd_seed, 0, 1) * sig_racc);
                vacc[j] = 0; nrst[j] = 0;
            end
            for (j = 0; j < 2; j = j + 1) begin rho[j] = rho0 * (1 + $rdist_normal(sd_seed, 0, 1) * sig_merge); vm[j] = 0; end
            for (j = 0; j < 64; j = j + 1) q0[j] = 0;
            t_sh0 = 0; etot = 0;
        end

        @(cross(V(phi_rst) - vth, -1)) begin
            for (g = 0; g < ROWS * 4; g = g + 1) qv[g] = V(q[g]);
            for (j = 0; j < ROWS * 4; j = j + 1) q0[j] = qv[j];
            for (j = 0; j < 4; j = j + 1)
                nrst[j] = noise * $rdist_normal(sd_seed, 0, 1) * sqrt(kt / ((j < 2) ? c_msb : c_lsb));
        end
        @(cross(V(phi_sh) - vth, 1)) t_sh0 = $abstime;
        @(cross(V(phi_sh) - vth, -1)) begin
            for (g = 0; g < ROWS * 4; g = g + 1) qv[g] = V(q[g]);
            settle = 1 - exp(-($abstime - t_sh0) / tau_col);
            for (sl = 0; sl < 2; sl = sl + 1)
                for (sd = 0; sd < 2; sd = sd + 1) begin
                    cs = (sl == 0) ? c_msb : c_lsb;
                    vtop = 0;
                    for (j = 0; j < ROWS; j = j + 1) vtop = vtop + qv[j * 4 + sl * 2 + sd] - q0[j * 4 + sl * 2 + sd];
                    vtop = vtop + nrst[sl * 2 + sd];
                    ca = cs * racc[sl * 2 + sd];
                    a = ca / (cs + ca);
                    vacc[sl * 2 + sd] = vacc[sl * 2 + sd] + (a * vacc[sl * 2 + sd] + (1 - a) * vtop - vacc[sl * 2 + sd]) * settle
                                        + noise * $rdist_normal(sd_seed, 0, 1) * sqrt(kt / (cs + ca));
                end
        end
        @(cross(V(phi_mrg) - vth, -1)) begin
            cm = c_msb * (r_acc + merge_on_top) * (1 + rho0);
            for (sd = 0; sd < 2; sd = sd + 1) begin
                vm[sd] = (vacc[sd] + rho[sd] * vacc[2 + sd]) / (1 + rho[sd]) + noise * $rdist_normal(sd_seed, 0, 1) * sqrt(kt / cm);
                vacc[sd] = 0; vacc[2 + sd] = 0;
            end
            etot = etot + e_sw;
        end
        V(outp) <+ transition(vm[0], 0, 10p);
        V(outn) <+ transition(vm[1], 0, 10p);
        V(emon) <+ etot * 1e12;
    end
endmodule
